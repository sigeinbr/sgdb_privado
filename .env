# Timezone
TZ=America/Sao_Paulo

# Conexão com o banco de dados do sistema
# Usa o mesmo cluster Postgres do projeto sgbd (container postgres-sigein, rede Docker
# "sigein") — não sobe uma instância própria. Isolamento vem de ser um banco de dados
# (DB_DATABASE) diferente dentro do mesmo cluster, não de uma instância separada.
DB_HOST=postgres-sigein
DB_PORT=5432
DB_DATABASE=target
DB_DBA_USERNAME=sgidba
DB_DBA_PASSWORD=sgidba
